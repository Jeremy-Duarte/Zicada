{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "aptPackages": [
      "libgobject-2.0-0",
      "libglib2.0-0",
      "libpango-1.0-0",
      "libpangocairo-1.0-0",
      "libcairo2",
      "libffi-dev",
      "libjpeg-dev",
      "libpng-dev",
      "zlib1g-dev"
    ]
  },
  "deploy": {
    "preDeployCommand": "python manage.py migrate && python manage.py collectstatic --noinput",
    "startCommand": "gunicorn --bind 0.0.0.0:$PORT config.wsgi:application"
  }
}