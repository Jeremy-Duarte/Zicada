# ============================================
# DJANGO SETTINGS
# ============================================
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# SEGURIDAD HTTPS (solo producción — dejar vacío en desarrollo)
# Cuando DJANGO_DEBUG=False, estos se activan automáticamente.
# Solo sobreescribe si necesitas un valor diferente al default.
# ============================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ============================================
# DATABASE (elige una opción)
# ============================================
# Opción 1: SQLite (desarrollo local)
DATABASE_URL=sqlite:///db.sqlite3

# Opción 2: PostgreSQL (producción)
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/zicada_db

# Opción 3: MySQL
# DATABASE_URL=mysql://usuario:contraseña@localhost:3306/zicada_db

# ============================================
# EMAIL SETTINGS
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=aaaa aaaa aaaa aaaa
DEFAULT_FROM_EMAIL=Zicada <tu_correo@gmail.com>

# Emails personalizados por función
FROM_EMAIL_NO_REPLY=Zicada <noreply@zicada.com>
FROM_EMAIL_ORDERS=Zicada Pedidos <pedidos@zicada.com>
FROM_EMAIL_SUPPORT=Zicada Soporte <soporte@zicada.com>

# API cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# API Stripe
STRIPE_PUBLISHABLE_KEY=pk_test
STRIPE_SECRET_KEY=sk_test
STRIPE_WEBHOOK_KEY=whk_test

# API Wompi (Bancolombia)
WOMPI_PUBLIC_KEY=pub_test
WOMPI_PRIVATE_KEY=prv_test
WOMPI_EVENTS_SECRET=events_secret_test
WOMPI_INTEGRITY_SECRET=integrity_secret_test
WOMPI_API_URL=https://sandbox.wompi.co/v1

# Tareas asíncronas: 'sync' | 'threading' | 'celery'
# 'sync'      — ejecuta en el request (máxima economía, sin infraestructura)
# 'threading' — hilo en background, responde 200 rápido (sin infraestructura)
# 'celery'    — requiere Redis + worker (mayor gasto de servidor)
ASYNC_BACKEND=sync
CELERY_BROKER_URL=memory://
CELERY_TASK_ALWAYS_EAGER=True